<section class="sheet-body item-body">

    {{!-- Type-specific fields (weapon, armor, …) plug in here. --}}
    {{#if typePartial}}
        {{> (lookup . "typePartial")}}
    {{/if}}

    {{!-- Shared inventory fields (from the base template). Features omit these. --}}
    {{#if hasInventoryFields}}
    <fieldset class="item-shared">
        <legend>{{localize "CONSTANTS.Item.Details"}}</legend>

        <div class="form-group">
            <label>{{localize "CONSTANTS.Item.Quantity"}}</label>
            <input type="text" name="system.quantity.value" value="{{system.quantity.value}}" data-dtype="Number" />
        </div>

        <div class="form-group">
            <label>{{localize "CONSTANTS.Item.Weight"}}</label>
            <input type="text" name="system.weight.value" value="{{system.weight.value}}" data-dtype="Number" />
        </div>

        <div class="form-group">
            <label>{{localize "CONSTANTS.Item.Price"}}</label>
            <input type="text" name="system.price.value" value="{{system.price.value}}" data-dtype="Number" />
            <select name="system.price.currency">
                {{selectOptions config.currencies selected=system.price.currency localize=true}}
            </select>
        </div>

        <div class="form-group">
            <label>{{localize "CONSTANTS.Item.Source"}}</label>
            <input type="text" name="system.source" value="{{system.source}}" />
        </div>
    </fieldset>
    {{/if}}

    <div class="form-group stacked">
        <label>{{localize "CONSTANTS.Item.Description"}}</label>
        <textarea name="system.description" rows="6">{{system.description}}</textarea>
    </div>

</section>
