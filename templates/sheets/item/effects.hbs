{{!--
    Item ActiveEffects manager. Wounds, passive features, and conditions carry their
    mechanical payload as transfer:true ActiveEffects on the item (wound-tables.md §4,
    effects-conditions.md §6) — this tab is where they're authored. CRUD is wired via
    the createEffect / editEffect / deleteEffect / toggleEffect sheet actions.

    On equippable items (weapon/armor/shield) each effect can also be proficiency-gated
    (effects-conditions.md §7): the min-proficiency input + (armor only) the
    under-proficiency penalty toggle write flags.wispers.* on the effect, applied by
    wispersActor._isEffectSuppressed. These controls edit effect flags (not item.system),
    so they carry no `name` and are wired by a change listener in _onRender.
--}}
<section class="item-effects">
    <ol class="items-list effects-list">
        <li class="items-header flexrow">
            <h3 class="item-name effect-name">{{localize "CONSTANTS.Effect.Label"}}</h3>
            {{#if gatable}}
            <div class="effect-gate-head">{{localize "CONSTANTS.Effect.Gate"}}</div>
            {{/if}}
            <div class="effect-duration">{{localize "EFFECT.TabDuration"}}</div>
            <div class="item-controls effect-controls flexrow">
                {{#if editable}}
                <a class="effect-control" data-action="createEffect" title="{{localize 'DOCUMENT.Create' type='Effect'}}">
                    <i class="fas fa-plus"></i> {{localize "DOCUMENT.New" type="Effect"}}
                </a>
                {{/if}}
            </div>
        </li>

        <ol class="item-list">
        {{#each effects as |effect|}}
            <li class="item effect flexrow" data-effect-id="{{effect.id}}">
                <div class="item-name effect-name flexrow">
                    <img class="item-image" src="{{effect.img}}" />
                    <h4>{{effect.name}}</h4>
                </div>

                {{#if @root.gatable}}
                <div class="effect-gate">
                    <label class="mini" title="{{localize 'CONSTANTS.Effect.GateMinHint'}}">{{localize "CONSTANTS.Effect.GateMin"}}</label>
                    <input class="effect-gate-min" type="number" min="0" max="5" step="1"
                           value="{{effect.minProficiency}}" {{#unless @root.editable}}disabled{{/unless}} />
                    {{#if @root.isArmor}}
                    <label class="effect-gate-under-label" title="{{localize 'CONSTANTS.Effect.GateUnderHint'}}">
                        <input class="effect-gate-under" type="checkbox"
                               {{#if effect.underProficiency}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                        {{localize "CONSTANTS.Effect.GateUnder"}}
                    </label>
                    {{/if}}
                </div>
                {{/if}}

                <div class="effect-duration">{{effect.durationLabel}}</div>
                <div class="item-controls effect-controls flexrow">
                    <a class="effect-control" data-action="toggleEffect" title="{{localize 'CONSTANTS.Effect.Toggle'}}">
                        <i class="fas {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i>
                    </a>
                    {{#if @root.editable}}
                    <a class="effect-control" data-action="editEffect" title="{{localize 'DOCUMENT.Update' type='Effect'}}">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a class="effect-control" data-action="deleteEffect" title="{{localize 'DOCUMENT.Delete' type='Effect'}}">
                        <i class="fas fa-trash"></i>
                    </a>
                    {{/if}}
                </div>
            </li>
        {{else}}
            <li class="item effect"><p class="hint">{{localize "CONSTANTS.Effect.None"}}</p></li>
        {{/each}}
        </ol>
    </ol>

    {{#if gatable}}
    <p class="hint effect-gate-note">{{localize "CONSTANTS.Effect.GateNote"}}</p>
    {{/if}}
</section>
