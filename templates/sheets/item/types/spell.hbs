<fieldset class="item-type-fields spell-fields">
    <legend>{{localize "CONSTANTS.Spell.Section"}}</legend>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Spell.School"}}</label>
        <select name="system.school.value">
            {{selectOptions schoolChoices selected=system.school.value localize=true}}
        </select>
    </div>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Spell.Level"}}</label>
        <input type="text" name="system.level.value" value="{{system.level.value}}" data-dtype="Number" />
    </div>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Spell.CastingTime"}}</label>
        <input type="text" name="system.castingTime.value" value="{{system.castingTime.value}}" data-dtype="Number" />
    </div>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Spell.Range"}}</label>
        <input type="text" name="system.range.value" value="{{system.range.value}}" />
    </div>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Spell.Duration"}}</label>
        <input type="text" name="system.duration.value" value="{{system.duration.value}}" />
    </div>

    <div class="form-group stacked">
        <label>{{localize "CONSTANTS.Spell.Components"}}</label>
        <div class="checkbox-row">
            <label class="checkbox">
                <input type="checkbox" name="system.components.verbal" {{#if system.components.verbal}}checked{{/if}} />
                {{localize "CONSTANTS.Spell.Verbal"}}
            </label>
            <label class="checkbox">
                <input type="checkbox" name="system.components.somatic" {{#if system.components.somatic}}checked{{/if}} />
                {{localize "CONSTANTS.Spell.Somatic"}}
            </label>
            <label class="checkbox">
                <input type="checkbox" name="system.components.material" {{#if system.components.material}}checked{{/if}} />
                {{localize "CONSTANTS.Spell.Material"}}
            </label>
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Spell.MaterialComponents"}}</label>
        <input type="text" name="system.components.materialComponents" value="{{system.components.materialComponents}}" />
    </div>

    <fieldset class="spell-degrees">
        <legend>{{localize "CONSTANTS.Spell.Degrees"}}</legend>
        <div class="form-group">
            <label>{{localize "CONSTANTS.Spell.DegreeCriticalFailure"}}</label>
            <input type="text" name="system.degrees.criticalFailure" value="{{system.degrees.criticalFailure}}" data-dtype="Number" />
        </div>
        <div class="form-group">
            <label>{{localize "CONSTANTS.Spell.DegreeFailure"}}</label>
            <input type="text" name="system.degrees.failure" value="{{system.degrees.failure}}" data-dtype="Number" />
        </div>
        <div class="form-group">
            <label>{{localize "CONSTANTS.Spell.DegreeSuccess"}}</label>
            <input type="text" name="system.degrees.success" value="{{system.degrees.success}}" data-dtype="Number" />
        </div>
        <div class="form-group">
            <label>{{localize "CONSTANTS.Spell.DegreeCriticalSuccess"}}</label>
            <input type="text" name="system.degrees.criticalSuccess" value="{{system.degrees.criticalSuccess}}" data-dtype="Number" />
        </div>
    </fieldset>

    <fieldset class="spell-scaling">
        <legend>{{localize "CONSTANTS.Spell.Scaling"}}</legend>
        <div class="form-group">
            <label>{{localize "CONSTANTS.Spell.ScalingBonus"}}</label>
            <input type="text" name="system.scaling.spellpowerBonus" value="{{system.scaling.spellpowerBonus}}" data-dtype="Number" />
        </div>
        <div class="form-group">
            <label>{{localize "CONSTANTS.Spell.ScalingMult"}}</label>
            <input type="text" name="system.scaling.spellpowerMult" value="{{system.scaling.spellpowerMult}}" data-dtype="Number" />
        </div>
        <div class="form-group">
            <label>{{localize "CONSTANTS.Spell.ScalingRider"}}</label>
            <input type="text" name="system.scaling.rider" value="{{system.scaling.rider}}" />
        </div>
    </fieldset>

    <fieldset class="spell-resolution">
        <legend>{{localize "CONSTANTS.Spell.Resolution"}}</legend>
        <div class="form-group">
            <label>{{localize "CONSTANTS.Spell.DealsWound"}}</label>
            <input type="checkbox" name="system.resolution.dealsWound" {{#if system.resolution.dealsWound}}checked{{/if}} />
        </div>
        <div class="form-group">
            <label>{{localize "CONSTANTS.Spell.TargetSave"}}</label>
            <select name="system.resolution.targetSave">
                {{selectOptions saveChoices selected=system.resolution.targetSave localize=true}}
            </select>
        </div>
        <div class="form-group stacked">
            <label>{{localize "CONSTANTS.Spell.WoundMod"}}</label>
            <div class="triple-row">
                <label class="mini">{{localize "CONSTANTS.Spell.WoundLight"}}</label>
                <input type="text" name="system.resolution.wound.light" value="{{system.resolution.wound.light}}" data-dtype="Number" />
                <label class="mini">{{localize "CONSTANTS.Spell.WoundNormal"}}</label>
                <input type="text" name="system.resolution.wound.normal" value="{{system.resolution.wound.normal}}" data-dtype="Number" />
                <label class="mini">{{localize "CONSTANTS.Spell.WoundHeavy"}}</label>
                <input type="text" name="system.resolution.wound.heavy" value="{{system.resolution.wound.heavy}}" data-dtype="Number" />
            </div>
        </div>
    </fieldset>
</fieldset>
