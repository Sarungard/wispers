<fieldset class="item-type-fields weapon-fields">
    <legend>{{localize "CONSTANTS.Weapon.Section"}}</legend>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Weapon.Category"}}</label>
        <select name="system.category.value">
            {{selectOptions weaponCategoryChoices selected=system.category.value localize=true}}
        </select>
    </div>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Weapon.Slug"}}</label>
        <input type="text" name="system.slug.value" value="{{system.slug.value}}" />
    </div>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Weapon.WeaponDie"}}</label>
        <input type="text" name="system.attack.weaponDie.value" value="{{system.attack.weaponDie.value}}" />
    </div>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Weapon.TargetSave"}}</label>
        <select name="system.attack.targetSave.value">
            {{selectOptions saveChoices selected=system.attack.targetSave.value localize=true}}
        </select>
    </div>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Weapon.ApCost"}}</label>
        <input type="text" name="system.attack.apCost.value" value="{{system.attack.apCost.value}}" data-dtype="Number" />
    </div>

    <div class="form-group stacked">
        <label>{{localize "CONSTANTS.Weapon.WoundMod"}}</label>
        <div class="triple-row">
            <label class="mini">{{localize "CONSTANTS.Weapon.WoundLight"}}</label>
            <input type="text" name="system.attack.wound.light" value="{{system.attack.wound.light}}" data-dtype="Number" />
            <label class="mini">{{localize "CONSTANTS.Weapon.WoundNormal"}}</label>
            <input type="text" name="system.attack.wound.normal" value="{{system.attack.wound.normal}}" data-dtype="Number" />
            <label class="mini">{{localize "CONSTANTS.Weapon.WoundHeavy"}}</label>
            <input type="text" name="system.attack.wound.heavy" value="{{system.attack.wound.heavy}}" data-dtype="Number" />
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Weapon.Range"}}</label>
        <input type="text" name="system.range.value" value="{{system.range.value}}" data-dtype="Number" />
        <input type="text" name="system.range.units" value="{{system.range.units}}" />
    </div>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Weapon.Equipped"}}</label>
        <input type="checkbox" name="system.equipped.value" {{#if system.equipped.value}}checked{{/if}} />
    </div>
</fieldset>

{{> "systems/wispers/templates/sheets/item/partials/properties.hbs"}}
