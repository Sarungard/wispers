<fieldset class="item-type-fields armor-fields">
    <legend>{{localize "CONSTANTS.Armor.Section"}}</legend>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Armor.Type"}}</label>
        <select name="system.armorType.value">
            {{selectOptions armorTypeChoices selected=system.armorType.value localize=true}}
        </select>
    </div>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Armor.Value"}}</label>
        <input type="text" name="system.armorValue.value" value="{{system.armorValue.value}}" data-dtype="Number" />
    </div>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Armor.Covers"}}</label>
        <select name="system.covers" multiple>
            {{selectOptions saveChoices selected=coversArray localize=true}}
        </select>
    </div>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Armor.RequiredProficiency"}}</label>
        <input type="text" name="system.requiredProficiency.value" value="{{system.requiredProficiency.value}}" data-dtype="Number" />
    </div>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Armor.Equipped"}}</label>
        <input type="checkbox" name="system.equipped.value" {{#if system.equipped.value}}checked{{/if}} />
    </div>
</fieldset>

{{> "systems/wispers/templates/sheets/item/partials/properties.hbs"}}
