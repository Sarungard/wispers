<fieldset class="item-type-fields shield-fields">
    <legend>{{localize "CONSTANTS.Shield.Section"}}</legend>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Shield.Value"}}</label>
        <input type="text" name="system.armorValue.value" value="{{system.armorValue.value}}" data-dtype="Number" />
    </div>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Shield.Covers"}}</label>
        <select name="system.covers" multiple>
            {{selectOptions saveChoices selected=coversArray localize=true}}
        </select>
    </div>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Shield.BlockApCost"}}</label>
        <input type="text" name="system.block.apCost" value="{{system.block.apCost}}" data-dtype="Number" />
    </div>

    <div class="form-group">
        <label>{{localize "CONSTANTS.Shield.Equipped"}}</label>
        <input type="checkbox" name="system.equipped.value" {{#if system.equipped.value}}checked{{/if}} />
    </div>
</fieldset>
