<div class="main" style="overflow: auto;">
    <div class="sidebar">
      <div class="sidebar-container">
        <h1 class="">Attributes</h1>
        <div>
          {{#each system.abilities as |ability|}}
            <li class="">
              <label for="system.abilities.{{ability.id}}" class="" >
                {{localize (concat "CONSTANTS.Attributes." ability.id ".long") }}
              </label>
              <input
                type="text"
                class="sidebar-stat-box {{attributeDie ability.value}}"
                name="system.abilities.{{ability.id}}"
                value="{{ability.value}}"
                data-dtype="Number" />
            </li>
          {{/each}}
        </div>
      </div>
    </div>
    <div class="content">
        <nav class="tabs" data-group="primary" data-tooltip-direction="UP" role="tablist">
            <span class=""></span>
                <a class="item" data-tab="character" data-tooltip="CONSTANTS.Tabs.Character" role="tab" aria-label="{{localize "CONSTANTS.Tabs.Character"}}" aria-selected="true">
                    <i class="fa-solid fa-book-open-cover"></i>
                </a>
                <a class="item" data-tab="inventory" data-tooltip="CONSTANTS.Tabs.Inventory" role="tab" aria-label="{{localize "CONSTANTS.Tabs.Inventory"}}">
                    <i class="fa-solid fa-box-open"></i>
                </a>
                <a class="item" data-tab="features" data-tooltip="CONSTANTS.Tabs.Features" role="tab" aria-label="{{localize "CONSTANTS.Tabs.Features"}}">
                    <i class="fa-solid fa-swords"></i>
                </a>
                <a class="item" data-tab="spellbook" data-tooltip="CONSTANTS.Tabs.Spellbook" role="tab" aria-label="{{localize "CONSTANTS.Tabs.Spellbook"}}">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                </a>
                <a class="item" data-tab="effects" data-tooltip="CONSTANTS.Tabs.Effects" role="tab" aria-label="{{localize "CONSTANTS.Tabs.Effects"}}">
                    <i class="fa-solid fa-person-rays"></i>
                </a>
                <a class="item" data-tab="biography" data-tooltip="CONSTANTS.Tabs.Biography" role="tab" aria-label="{{localize "CONSTANTS.Tabs.Biography"}}">
                    <i class="fa-solid fa-book"></i>
                </a>
        </nav>

      <div class="">
        <section class="">
            <div class="tab" data-tab="character" data-group="primary">
                {{> "systems/wispers/templates/partials/character/attributes.hbs"}}
            </div>

            <div class="tab" data-tab="inventory" data-group="primary">
                {{> "systems/wispers/templates/partials/character/inventory.hbs"}}
            </div>

            <div class="tab" data-tab="features" data-group="primary">
                {{> "systems/wispers/templates/partials/character/features.hbs"}}
            </div>

            <div class="tab" data-tab="spellbook" data-group="primary">
                {{> "systems/wispers/templates/partials/character/spellbook.hbs"}}
            </div>

            <div class="tab" data-tab="effects" data-group="primary">
                {{> "systems/wispers/templates/partials/character/effects.hbs"}}
            </div>

            <div class="tab" data-tab="biography" data-group="primary">
                {{> "systems/wispers/templates/partials/character/biography.hbs"}}
            </div>
        </section>
      </div>
    </div>
</div>