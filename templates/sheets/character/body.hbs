<div>
    <div class="bodyBox">

        <div class="imgBox">
            <img class="charImg" src="{{actor.img}}" data-edit="img" data-action="editImage" title="{{actor.name}}" >
            <div class="imgOverlay">
                <div class="charReaSpeed"></div>
                <div class="charRes1 charResFirst"><span class="charResHead">Reflex</span><br><span class="charResValue">+3</span></div>
                <div class="charRes1"><span class="charResHead">Toughness</span><br><span class="charResValue">+4</span></div>
            </div>
            <div class="charRes1 charResMiddle"><span class="charResHead">Resolve</span><br><span class="charResValue">+5</span></div>
        </div>

        <div class="bodyFill1"></div>

    <div class="charStatfieldset" style="color: #2A2622;">
        <h1 class="charStatlegend">Attributes</h1>
        <div>
        {{#each system.abilities as |ability|}}
        {{log ability}}
            <li class='item flexrow flex-group-center'>
                <label for="system.abilities.{{ability.id}}" class="resource-label rollable flexlarge align-left">{{localize (concat "CONSTANTS.Attributes." ability.id ".long")}}</label>
                <input type="text" name="system.abilities.{{ability.id}}" value="{{ability.value}}" data-dtype="Number"/>
            </li>
        {{/each}}
        </div>
    </div>

        <div class="bodyFill2"></div>

        <div class="bodyFill3"></div>

    </div>

    <div class="menuBox">

        <div class="menuBG"></div>
        <div class="menuLbl"></div>

        <nav class="tabs menuTabs" data-group="primary-tabs">
            <div class="menuIcon" style="left: 135px;">
                <a class="item" data-tab="tab1" data-group="primary-tabs">
                    <i class="fa-solid fa-book-open-cover"></i>
                </a>
            </div>
            <div class="menuIcon" style="left: 180px;">
                <a class="item" data-tab="tab2" data-group="primary-tabs">
                    <i class="fa-solid fa-swords"></i>
                </a>
            </div>
            <div class="menuIcon" style="left: 225px;">
                <a class="item" data-tab="tab3" data-group="primary-tabs">
                    <i class="fa-regular fa-ellipsis-vertical"></i>
                </a>
            </div>
            <div class="menuIcon" style="left: 270px;">
                <a class="item" data-tab="tab4" data-group="primary-tabs">
                    <i class="fa-regular fa-stars"></i>
                </a>
            </div>
            <div class="menuIcon" style="left: 315px;">
                <a class="item" data-tab="tab5" data-group="primary-tabs">
                    <i class="fa-solid fa-aperture"></i>
                </a>
            </div>
            <div class="menuIcon" style="left: 360px;">
                <a class="item" data-tab="tab6" data-group="primary-tabs">
                    <i class="fa-solid fa-book"></i>
                </a>
            </div>
        </nav>

    </div>

    <div class="contentBox">
        <section class="content">
            <div class="tab" data-tab="tab1" data-group="primary-tabs">
                {{> "systems/wispers/templates/partials/character/attributes.hbs"}}
            </div>

            <div class="tab" data-tab="tab2" data-group="primary-tabs">
                {{> "systems/wispers/templates/partials/character/inventory.hbs"}}
            </div>

            <div class="tab" data-tab="tab3" data-group="primary-tabs">
                {{> "systems/wispers/templates/partials/character/features.hbs"}}
            </div>

            <div class="tab" data-tab="tab4" data-group="primary-tabs">
                {{> "systems/wispers/templates/partials/character/spellbook.hbs"}}
            </div>

            <div class="tab" data-tab="tab5" data-group="primary-tabs">
                {{> "systems/wispers/templates/partials/character/effects.hbs"}}
            </div>

            <div class="tab" data-tab="tab6" data-group="primary-tabs">
                {{> "systems/wispers/templates/partials/character/biography.hbs"}}
            </div>
        </section>
    </div>
</div>