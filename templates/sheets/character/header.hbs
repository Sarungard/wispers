<div class="headerBox">

  <div class="logoBox">
    <div class="logoImg"><div class="logoText">{{localize
          "WISPERS.SystemName"
        }}</div></div>
  </div>

  <div class="charInfoBox">
    <input
      class="bigInputText"
      type="text"
      name="name"
      value="{{actor.name}}"
    />
    <div class="lvlBox">
      <div class="lvlLable">{{localize "WISPERS.System.LevelFull"}}</div>
      <div class="lvlValue">{{system.level}}</div>
    </div>
  </div>
</div>