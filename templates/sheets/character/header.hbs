<div class="header">
    <div class="character-image-container">
        <img
            class="character-image"
            src="{{actor.img}}"
            data-edit="img"
            data-action="editImage"
            title="{{actor.name}}" />
    </div>
    <div class="character-information">
        <div class="character-namebar">
            <input
                class="character-name"
                type="text"
                name="name"
                value="{{actor.name}}" />
            <div class="character-class">
                {{system.class.name}}
                <span class="character-level">{{localize "SYSTEM.LevelShort"}} {{system.level.value}}</span>
            </div>
        </div>

        <div class="saves-row">
            <div class="save">
                <span class="save-label">Reflex</span>
                <span class="save-die die {{proficiencyDie system.skills.savingthrows.reflex.proficiency.value}}">+{{system.abilities.agi.value}}</span>
            </div>
            <div class="save">
                <span class="save-label">Toughness</span>
                <span class="save-die die {{proficiencyDie system.skills.savingthrows.toughness.proficiency.value}}">+{{system.abilities.con.value}}</span>
            </div>
            <div class="save">
                <span class="save-label">Resolve</span>
                <span class="save-die die {{proficiencyDie system.skills.savingthrows.resolve.proficiency.value}}">+{{system.abilities.spi.value}}</span>
            </div>
            <div class="save">
                <span class="save-label">Light Wound</span>
                <span class="save-die die wound-threshold light">{{system.wounds.lightThreshold.value}}</span>
            </div>
            <div class="save">
                <span class="save-label">Heavy Wound</span>
                <span class="save-die die wound-threshold heavy">{{system.wounds.heavyThreshold.value}}</span>
            </div>
        </div>
    </div>
</div>
