<div class="header">
    <div class="character-image-container">
        <img
            class="character-image"
            src="{{actor.img}}"
            data-edit="img"
            data-action="editImage"
            title="{{actor.name}}" />
    </div>
    <div class="character-information">
        <div class="character-namebar">
            <input
                class="character-name"
                type="text"
                name="name"
                value="{{actor.name}}" />
            <div class="character-meta">
                <div class="level-row">
                    <span class="character-level">{{localize "SYSTEM.LevelShort"}} {{system.level.value}}</span>
                    <span class="character-class">{{system.class.name}}</span>
                    <button type="button" class="level-up-btn" data-action="levelUp"
                            title="{{localize "SYSTEM.LevelUp"}}">
                        <i class="fas fa-angles-up"></i>
                    </button>
                </div>
                <div class="action-points" title="{{localize "CONSTANTS.ActionPoints.Tooltip"}}">
                    <span class="ap-label">{{localize "CONSTANTS.ActionPoints.Short"}}</span>
                    <span class="ap-value">{{system.initiative.remaining}}<span class="ap-sep">/</span>{{system.initiative.total}}</span>
                </div>
            </div>
        </div>

        <div class="saves-row">
            <div class="save">
                <span class="save-label rollable" data-roll-save="reflex">{{localize "CONSTANTS.SavingThrows.Reflex"}}</span>
                <span class="save-die die rollable {{proficiencyDie system.skills.savingthrows.reflex.proficiency.effective}}" data-roll-save="reflex">+{{system.abilities.agi.effective}}</span>
            </div>
            <div class="save">
                <span class="save-label rollable" data-roll-save="toughness">{{localize "CONSTANTS.SavingThrows.Toughness"}}</span>
                <span class="save-die die rollable {{proficiencyDie system.skills.savingthrows.toughness.proficiency.effective}}" data-roll-save="toughness">+{{system.abilities.con.effective}}</span>
            </div>
            <div class="save">
                <span class="save-label rollable" data-roll-save="resolve">{{localize "CONSTANTS.SavingThrows.Resolve"}}</span>
                <span class="save-die die rollable {{proficiencyDie system.skills.savingthrows.resolve.proficiency.effective}}" data-roll-save="resolve">+{{system.abilities.spi.effective}}</span>
            </div>
            <div class="save">
                <span class="save-label">Light Wound</span>
                <span class="save-die die wound-threshold light">{{system.wounds.lightThreshold.value}}</span>
            </div>
            <div class="save">
                <span class="save-label">Heavy Wound</span>
                <span class="save-die die wound-threshold heavy">{{system.wounds.heavyThreshold.value}}</span>
            </div>
        </div>
    </div>
</div>
