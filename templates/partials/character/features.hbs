<div class="features-body inventory-body">
    <header class="inventory-header">
        <div class="search">
            <input type="search" spellcheck="false" placeholder="{{localize "CONSTANTS.Search"}}" />
        </div>
    </header>
    {{#each featureSections as |section|}}
    <div class="inventory-section">

        <div class="items-header flexrow">
            <div class="item-name">
                <h3>{{localize section.labelKey}}</h3>
            </div>
            <div class="item-prop inv-col-header">{{localize "CONSTANTS.Features.ColUses"}}</div>
            <div class="item-controls">
                {{#if ../editable}}
                <a data-action="createItem" data-type="feature" data-feature-type="{{section.type}}"
                   data-tooltip="{{localize 'CONSTANTS.Features.AddFeature'}}">
                    <i class="fas fa-plus fa-fw"></i>
                </a>
                {{/if}}
            </div>
        </div>

        <ol class="item-list">
            {{#each section.items as |item|}}
            <li class="item flexrow" data-item-id="{{item.id}}">
                <div class="item-name flexrow">
                    <img class="item-image rollable" src="{{item.img}}" alt="{{item.name}}" data-item-card="{{item.id}}"
                          data-tooltip="{{localize 'CONSTANTS.Item.Description'}}"/>
                    <h4 class="item-toggle" data-action="toggleDescription"
                        data-tooltip="{{localize 'CONSTANTS.Item.Description'}}">{{item.name}}</h4>
                </div>
                <div class="item-prop">{{item.system.uses.value}} / {{item.system.uses.max}}</div>
                <div class="item-controls flexrow">
                    {{#if ../../editable}}
                    <a class="item-control" data-action="editItem" data-item-id="{{item.id}}"
                       data-tooltip="{{localize 'CONSTANTS.Features.EditFeature'}}">
                        <i class="fas fa-edit fa-fw"></i>
                    </a>
                    <a class="item-control" data-action="deleteItem" data-item-id="{{item.id}}"
                       data-tooltip="{{localize 'CONSTANTS.Features.DeleteFeature'}}">
                        <i class="fas fa-trash fa-fw"></i>
                    </a>
                    {{/if}}
                </div>
            </li>
            {{/each}}
        </ol>

    </div>
    {{/each}}
</div>
