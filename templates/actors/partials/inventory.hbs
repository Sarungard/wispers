<div class="inventory-body items-list">
    {{#each inventorySections as |section|}}
    <div class="inventory-section">

        <div class="items-header flexrow">
            <div class="item-name">
                <h3>{{localize section.labelKey}}</h3>
            </div>
            <div class="item-meta inv-col-header">{{localize "CONSTANTS.Inventory.ColGroup"}}</div>
            <div class="item-meta inv-col-header">{{localize "CONSTANTS.Inventory.ColProf"}}</div>
            <div class="item-prop inv-col-header">{{localize "CONSTANTS.Inventory.ColQty"}}</div>
            <div class="item-prop inv-col-header">{{localize "CONSTANTS.Inventory.ColWgt"}}</div>
            <div class="item-prop inv-col-header">{{localize "CONSTANTS.Inventory.ColPrice"}}</div>
            <div class="item-controls">
                {{#if ../editable}}
                <a data-action="createItem" data-type="{{section.type}}"
                   data-tooltip="{{localize 'CONSTANTS.Inventory.AddItem'}}">
                    <i class="fas fa-plus fa-fw"></i>
                </a>
                {{/if}}
            </div>
        </div>

        <ol class="item-list">
            {{#each section.items as |entry|}}
            <li class="item flexrow" draggable="true" data-item-id="{{entry.item.id}}">
                <div class="item-name flexrow">
                    {{#if entry.item.system.attack}}
                    <img class="item-image rollable" src="{{entry.item.img}}" alt="{{entry.item.name}}" data-roll-weapon="{{entry.item.id}}"
                          data-tooltip="{{localize 'CONSTANTS.Roll.Threat'}}"/>
                    {{else}}
                    <img class="item-image rollable" src="{{entry.item.img}}" alt="{{entry.item.name}}" data-item-card="{{entry.item.id}}"
                          data-tooltip="{{localize 'CONSTANTS.Item.Description'}}"/>
                    {{/if}}
                    <h4 class="item-toggle" data-action="toggleDescription"
                        data-tooltip="{{localize 'CONSTANTS.Item.Description'}}">{{entry.item.name}}</h4>
                </div>
                <div class="item-meta" data-tooltip="{{localize 'CONSTANTS.Inventory.ColGroup'}}">{{entry.group}}</div>
                <div class="item-meta" data-tooltip="{{localize 'CONSTANTS.Inventory.ColProf'}}">{{entry.prof}}</div>
                <div class="item-prop">{{entry.item.system.quantity.value}}</div>
                <div class="item-prop">{{entry.item.system.weight.value}}</div>
                <div class="item-prop">{{entry.item.system.price.value}}</div>
                <div class="item-controls flexrow">
                    {{#if entry.item.system.equipped}}
                        {{#if ../../editable}}
                        <a class="item-control equip-toggle{{#if entry.item.system.equipped.value}} is-equipped{{/if}}"
                           data-action="toggleEquipped" data-item-id="{{entry.item.id}}"
                           data-tooltip="{{#if entry.item.system.equipped.value}}{{localize 'CONSTANTS.Inventory.Unequip'}}{{else}}{{localize 'CONSTANTS.Inventory.Equip'}}{{/if}}">
                            <i class="fas fa-shield-halved fa-fw"></i>
                        </a>
                        {{else}}
                        <i class="fas fa-shield-halved fa-fw item-control equip-toggle{{#if entry.item.system.equipped.value}} is-equipped{{/if}}"></i>
                        {{/if}}
                    {{/if}}
                    {{#if ../../editable}}
                    <a class="item-control" data-action="editItem" data-item-id="{{entry.item.id}}"
                       data-tooltip="{{localize 'CONSTANTS.Inventory.EditItem'}}">
                        <i class="fas fa-edit fa-fw"></i>
                    </a>
                    <a class="item-control" data-action="deleteItem" data-item-id="{{entry.item.id}}"
                       data-tooltip="{{localize 'CONSTANTS.Inventory.DeleteItem'}}">
                        <i class="fas fa-trash fa-fw"></i>
                    </a>
                    {{/if}}
                </div>
            </li>
            {{/each}}
        </ol>

    </div>
    {{/each}}
</div>
